# Kakao Developers (https://developers.kakao.com) 에서 애플리케이션을 생성한 뒤
# "앱 키" 메뉴에서 아래 두 값을 발급받아 채워주세요.

# JavaScript 키 - 지도(Kakao Maps SDK)를 브라우저에 그리는 용도
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
KAKAO_JS_KEY=

# REST API 키 - 서버에서 장소 검색(Local API)을 호출하는 용도
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# 서버 포트 (선택, 로컬 실행에만 사용)
PORT=3000

# Vercel처럼 파일시스템에 쓸 수 없는 서버리스 환경에 배포할 때만 필요합니다.
# Vercel 대시보드 > Storage > Upstash for Redis 연동을 추가하면 아래 두 값이 자동으로 채워집니다.
# (로컬 실행이나 Render처럼 일반 서버에 배포할 때는 비워두면 data/store.json 파일을 사용합니다.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
