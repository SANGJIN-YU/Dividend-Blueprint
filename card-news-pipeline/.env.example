# DART Open API (https://opendart.fss.or.kr)
DART_API_KEY=

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 뉴스 언급량 API (예: 빅카인즈). MVP 기본값은 mock 프로바이더.
NEWS_API_KEY=
NEWS_API_PROVIDER=mock

# 주가 등락률 조회 프로바이더. MVP 기본값은 mock 프로바이더.
STOCK_API_KEY=
STOCK_API_PROVIDER=mock

# 실행 옵션
TOPIC_COMPANY_COUNT=3
MIN_ABS_PRICE_CHANGE_RATE=1.5
PUPPETEER_EXECUTABLE_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# true 로 설정하면 외부 API를 호출하지 않고 data/fixtures 의 샘플 데이터로 전체 파이프라인을 실행합니다.
MOCK_MODE=false
